# Healthcare Analytics Starter Kit - Environment Configuration
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Connection (Analytics Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_analytics
POSTGRES_USER=hask_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_SSLMODE=prefer

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_production
GRAFANA_ROOT_URL=http://localhost:3000

# =============================================================================
# EMR CONNECTOR CONFIGURATION
# =============================================================================

# --- FHIR API (Epic, Cerner, etc.) ---
FHIR_BASE_URL=https://your-emr.example.com/fhir/r4
FHIR_CLIENT_ID=your_client_id
FHIR_CLIENT_SECRET=your_client_secret
FHIR_TOKEN_URL=https://your-emr.example.com/oauth2/token
FHIR_SCOPES=patient/*.read,encounter/*.read,observation/*.read

# --- Epic Specific ---
EPIC_PRIVATE_KEY_PATH=/path/to/epic_private_key.pem
EPIC_CLIENT_ID=your_epic_client_id
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# --- Cerner/Oracle Health Specific ---
CERNER_SYSTEM_ACCOUNT_ID=your_system_account
CERNER_SECRET=your_cerner_secret
CERNER_BASE_URL=https://fhir-ehr.cerner.com/r4/tenant-id

# --- HL7 Feed Configuration ---
HL7_LISTENER_HOST=0.0.0.0
HL7_LISTENER_PORT=2575
HL7_MLLP_TIMEOUT=30

# --- CSV/File Ingestion ---
CSV_IMPORT_PATH=/data/imports
CSV_ARCHIVE_PATH=/data/archives
CSV_ERROR_PATH=/data/errors
CSV_FILE_PATTERN=*.csv

# --- Database Read Replica (Direct EMR Connection) ---
EMR_REPLICA_HOST=emr-replica.example.com
EMR_REPLICA_PORT=1433
EMR_REPLICA_DB=EMR_REPORTING
EMR_REPLICA_USER=readonly_user
EMR_REPLICA_PASSWORD=changeme
EMR_REPLICA_DRIVER=mssql+pyodbc

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================

# Field-level encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Audit logging
AUDIT_LOG_PATH=/var/log/healthcare-analytics/audit.log
AUDIT_LOG_LEVEL=INFO

# PHI Scanner sensitivity (low, medium, high)
PHI_SCAN_SENSITIVITY=high

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/healthcare-analytics/app.log

# Pipeline settings
PIPELINE_BATCH_SIZE=1000
PIPELINE_MAX_WORKERS=4
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY=60

# Data retention (days)
STAGING_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=2555

# =============================================================================
# OPTIONAL: pgAdmin (for database management UI)
# =============================================================================

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# =============================================================================
# OPTIONAL: External Integrations
# =============================================================================

# SFTP for file transfers
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=sftp_user
SFTP_PRIVATE_KEY_PATH=/path/to/sftp_key
SFTP_REMOTE_PATH=/outbound/analytics

# Slack notifications (for pipeline alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=email_password
ALERT_EMAIL_TO=team@example.com
